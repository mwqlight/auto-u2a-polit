# Auto U2A Polit Frontend - Production Environment

# 应用基础配置
VITE_APP_TITLE=Auto U2A Polit
VITE_APP_DESCRIPTION=企业级用户平台驾驶舱系统
VITE_APP_VERSION=1.0.0
VITE_APP_BASE_URL=/

# API 配置
VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_TIMEOUT=30000
VITE_API_PREFIX=/api

# 认证配置
VITE_JWT_SECRET=prod-jwt-secret-key-2024
VITE_TOKEN_KEY=access_token
VITE_REFRESH_TOKEN_KEY=refresh_token
VITE_TOKEN_EXPIRE=7200

# 开发环境配置
VITE_DEV_SERVER_PORT=3000
VITE_DEV_SERVER_HOST=0.0.0.0

# 功能开关
VITE_ENABLE_DEBUG=false
VITE_ENABLE_MOCK=false
VITE_ENABLE_ANALYTICS=true

# 第三方服务
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxx

# 主题配置
VITE_THEME_PRIMARY=#409EFF
VITE_THEME_SUCCESS=#67C23A
VITE_THEME_WARNING=#E6A23C
VITE_THEME_DANGER=#F56C6C
VITE_THEME_INFO=#909399

# 构建配置
VITE_BUILD_SOURCEMAP=false
VITE_BUILD_MINIFY=true